# Copie para .env.local e preencha. Nunca commite o .env.local.
# Onde achar cada valor no painel do Supabase está em replica/backend.md.

# Endereço público do app (usado nos links dos e-mails). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Segredo: só no servidor. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Connect → ORMs/Postgres. App: pooler em modo transação (porta 6543).
DATABASE_URL=
# Migrações: conexão direta (porta 5432) ou pooler em modo sessão.
DIRECT_URL=

# Arquivos: "supabase" em produção (bucket privado), "local" só para desenvolvimento.
STORAGE_DRIVER=supabase
STORAGE_BUCKET=files

# Opcional: quem pode criar conta. Ex.: "voce@gmail.com, @suaagencia.com.br". Vazio = qualquer um.
SIGNUP_ALLOWLIST=

# Opcional: conexões simultâneas com o banco por instância.
DB_POOL_MAX=5

# Só para o seed local (npm run seed)
SEED_EMAIL=
SEED_PASSWORD=
