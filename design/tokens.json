{
  "$meta": {
    "name": "clone-tokens",
    "version": "1.0.0",
    "notes": "Papéis (roles) são fixos; o /replica-brand só troca valores. Azul marinho = primary, amarelo = accent. Amarelo nunca é texto nem anel de foco sobre fundo claro (1.65:1). No escuro, primary é claro (não amarelo) para não competir com o accent: amarelo = gerar/aprovar nos dois temas."
  },
  "color": {
    "light": {
      "bg": "#F6F7F9",
      "surface": "#FFFFFF",
      "surface-2": "#EDF0F4",
      "surface-inverse": "#0B1B33",
      "border": "#DCE1E8",
      "border-input": "#7A8699",
      "text": "#0B1B33",
      "text-muted": "#4B5A70",
      "text-inverse": "#F2F5FA",
      "primary": "#13294B",
      "primary-hover": "#1D3A66",
      "on-primary": "#FFFFFF",
      "accent": "#F5C33B",
      "accent-hover": "#F0B514",
      "on-accent": "#0B1B33",
      "accent-subtle": "#FEF6DC",
      "on-accent-subtle": "#0B1B33",
      "ring": "#13294B",
      "link": "#1D3A66",
      "danger": "#B42318",
      "danger-subtle": "#FEE4E2",
      "on-danger": "#FFFFFF",
      "success": "#067647",
      "success-subtle": "#DCFAE6",
      "warning": "#B54708",
      "warning-subtle": "#FEF0E0",
      "overlay": "rgba(11, 27, 51, 0.48)"
    },
    "dark": {
      "bg": "#0A1628",
      "surface": "#10213B",
      "surface-2": "#172C4D",
      "surface-inverse": "#F2F5FA",
      "border": "#24395C",
      "border-input": "#6A80A6",
      "text": "#F2F5FA",
      "text-muted": "#A9B6CA",
      "text-inverse": "#0B1B33",
      "primary": "#E6EBF2",
      "primary-hover": "#FFFFFF",
      "on-primary": "#0B1B33",
      "accent": "#F5C33B",
      "accent-hover": "#F8D265",
      "on-accent": "#0B1B33",
      "accent-subtle": "#3A3218",
      "on-accent-subtle": "#FCE7A6",
      "ring": "#F5C33B",
      "link": "#F8D265",
      "danger": "#F97066",
      "danger-subtle": "#3D1A1C",
      "on-danger": "#0B1B33",
      "success": "#47CD89",
      "success-subtle": "#0F3326",
      "warning": "#FD853A",
      "warning-subtle": "#3B2414",
      "overlay": "rgba(2, 8, 18, 0.64)"
    }
  },
  "font": {
    "family": {
      "display": "'Manrope', ui-sans-serif, system-ui, sans-serif",
      "body": "'Inter', ui-sans-serif, system-ui, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, monospace"
    },
    "size": {
      "xs": {
        "size": "12px",
        "line": "16px"
      },
      "sm": {
        "size": "14px",
        "line": "20px"
      },
      "md": {
        "size": "16px",
        "line": "24px"
      },
      "lg": {
        "size": "20px",
        "line": "28px"
      },
      "xl": {
        "size": "24px",
        "line": "32px"
      },
      "2xl": {
        "size": "32px",
        "line": "40px"
      },
      "3xl": {
        "size": "40px",
        "line": "48px"
      }
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    }
  },
  "space": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(11, 27, 51, 0.06), 0 1px 3px rgba(11, 27, 51, 0.10)",
    "md": "0 4px 12px rgba(11, 27, 51, 0.10)",
    "lg": "0 16px 40px rgba(11, 27, 51, 0.18)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "layout": {
    "sidebar": "248px",
    "header": "56px",
    "content-max": "1200px",
    "gutter-mobile": "16px",
    "breakpoints": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px"
    }
  },
